SECRET_KEY = config(
    'SECRET_KEY',
    default='django-insecure-local-development-only-change-me',
)

DATABASES = {
    'default': (
        {
        'ENGINE': 'django.db.backends.mysql',
        'NAME': config('DB_NAME'),
        'HOST': config('DB_HOST'),
        'PORT': config('DB_PORT'),
        'USER': config('DB_USER'),
        'PASSWORD': config('DB_PASSWORD'),
        }
        if config('DB_NAME', default='')
        else {
            'ENGINE': 'django.db.backends.sqlite3',
            'NAME': BASE_DIR / 'db.sqlite3',
        }
    ),
}
